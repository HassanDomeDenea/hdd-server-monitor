# Basic auth for the dashboard
APP_USERNAME=admin
APP_PASSWORD=admin

# Enable/disable email notifications
MAIL_ENABLED=true

# Where down/resolved notifications are sent
NOTIFY_EMAIL=hassan.domedenea@gmail.com

# Telegram notifications: create a bot with @BotFather, add it as an admin of
# your private channel, then set the channel chat id (e.g. -1001234567890).
# Tip: leave TELEGRAM_CHAT_ID empty and run `php tools/test-telegram.php`
# after posting a message in the channel - it will list the chat ids it sees.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Secret required to trigger job.php over HTTP (CLI runs don't need it)
# e.g. curl "https://your-site/job.php?secret=change-me"
CRON_SECRET=change-me

# SMTP settings (PHPMailer). If SMTP_HOST is empty, falls back to PHP mail().
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM=monitor@example.com
SMTP_FROM_NAME="HDD Server Monitor"

# Request timeout in seconds for endpoint checks
CHECK_TIMEOUT=10

# Consecutive failed checks before an endpoint is declared down and alerted.
# 2 means a single one-minute network blip won't trigger a notification.
FAILURE_THRESHOLD=2

# Extra immediate retries within a single run before a probe counts as failed
# (0.5s apart). 0 keeps run time unchanged; raise for noisier networks.
CHECK_RETRIES=0

# Timezone for displayed times (database stores UTC)
TIMEZONE=Asia/Baghdad

# How many days of events to show on the dashboard
EVENTS_DAYS=7
